# Copie para api\.env e preencha. O boot aborta com mensagem legível se algo faltar.
# Ver .docs/07-integracao-spotify.md §9 para o checklist de setup.

# do dashboard do Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 🔴 IP literal. O Spotify NÃO aceita `localhost` aqui, e o erro que ele devolve
# ("INVALID_CLIENT: Invalid redirect URI") não menciona isso.
# Tem de ser byte a byte igual ao registrado no dashboard, barra final incluída.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# nome com que o app desktop do Spotify se registra (normalmente o nome do computador).
# É o NOME, não o id — device_id não é persistente. Ver 07 §3.
SPOTIFY_DEVICE_NAME=PUMBABOOK

# RF-31 · 4 dígitos, design de jogo e não segurança (ADR-007)
HOST_PIN=4271

BIND_HOST=0.0.0.0
BIND_PORT=80

# --- rede da festa: o QR que conecta o celular no Wi-Fi (segundo QR do /tv) ------------------
# Deixe WIFI_SSID vazio para não mostrar esse QR — o /tv volta a exibir só o da fila.
#
# 🔴 Tem de ser o SSID DE VERDADE, e no Windows há uma pegadinha: o
# `Get-NetConnectionProfile` devolve o nome do PERFIL de rede, que ganha sufixo quando o SO já
# viu duas redes distintas com o mesmo nome — ele diz `MinhaRede 2` para um SSID `MinhaRede`.
# Um QR com o sufixo escaneia perfeitamente e conecta em NADA. Pegue o valor certo com:
#     netsh wlan show interfaces
# O start.ps1 compara com a rede conectada e avisa se divergir.
WIFI_SSID=
WIFI_PASSWORD=
# WPA cobre WPA/WPA2/WPA3. Use `nopass` se a rede for aberta (e aí deixe a senha vazia).
WIFI_AUTH=WPA
WIFI_HIDDEN=false
